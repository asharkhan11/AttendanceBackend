# ── Stage 1: Build Migration & Seeding Binaries ─────────────────────────────
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Cache module dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source tree
COPY . .

# Build statically linked Migration binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build \
    -ldflags="-w -s -extldflags '-static'" \
    -o /app/bin/attendance-migrate \
    ./cmd/migrate/

# Build statically linked Seeding binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build \
    -ldflags="-w -s -extldflags '-static'" \
    -o /app/bin/attendance-seed \
    ./cmd/seed/

# ── Stage 2: Database Initialization Runtime Image ──────────────────────────
FROM alpine:3.19 AS runtime

WORKDIR /app

# Install postgresql-client for pg_isready, SSL certs, and timezone data
RUN apk add --no-cache ca-certificates tzdata postgresql-client

# Copy statically compiled binaries and migration SQL assets
COPY --from=builder /app/bin/attendance-migrate /app/attendance-migrate
COPY --from=builder /app/bin/attendance-seed /app/attendance-seed
COPY --from=builder /app/internal/db/migrations /app/internal/db/migrations
COPY deployments/entrypoint-db-init.sh /app/entrypoint-db-init.sh

RUN chmod +x /app/entrypoint-db-init.sh /app/attendance-migrate /app/attendance-seed

ENTRYPOINT ["/app/entrypoint-db-init.sh"]
